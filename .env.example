# ============================================================
# MasteryHub — Environment Variables
# Copy to .env for local dev, or paste into Coolify's
# "Environment Variables" panel for production.
# NEVER commit your real .env to version control.
# ============================================================

# ── Django core ─────────────────────────────────────────────
SECRET_KEY=your-long-random-secret-key-here
DEBUG=False

# ── Hosts & origins ─────────────────────────────────────────
# Comma-separated list — add your Coolify domain here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Full HTTPS URLs of your domain(s), comma-separated
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Used in outgoing email links
SITE_DOMAIN=yourdomain.com

# ── Database ─────────────────────────────────────────────────
# Coolify injects this automatically when you link a PostgreSQL service.
# For local dev with docker compose, override this in docker-compose.yml.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional separate test DB
# TEST_DATABASE_URL=

# ── AWS S3 (static & media files) ───────────────────────────
USE_AWS=True
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe payments ──────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WH_SECRET=whsec_...

# ── Email (Postmark SMTP) ────────────────────────────────────
POSTMARK_ACCESS_KEY=your-postmark-server-token
POSTMARK_SECRET_KEY=your-postmark-server-token

# ── Google OAuth2 ────────────────────────────────────────────
SOCIALACCOUNT_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SOCIALACCOUNT_GOOGLE_SECRET=your-google-secret

# ── Gunicorn tuning (optional) ───────────────────────────────
PORT=8000
GUNICORN_WORKERS=2
